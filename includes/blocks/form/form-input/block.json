{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "axellcore/form-input",
	"title": "Atelier Form Field",
	"category": "text",
	"ancestor": [ "axellcore/form" ],
	"description": "A form field: text, email, tel, number, textarea, select, consent checkbox, or hidden — with optional input masking (CPF/CNPJ, CEP, phone).",
	"keywords": [ "input", "field", "form" ],
	"textdomain": "axellcore-atelierclub",
	"attributes": {
		"type": { "type": "string", "default": "text" },
		"variant": { "type": "string", "default": "field" },
		"name": { "type": "string", "default": "" },
		"label": {
			"type": "rich-text",
			"source": "rich-text",
			"selector": ".aac-field-label-text",
			"default": "Label"
		},
		"required": { "type": "boolean", "default": false },
		"placeholder": { "type": "string", "default": "" },
		"hint": { "type": "string", "default": "" },
		"value": { "type": "string", "default": "" },
		"checked": { "type": "boolean", "default": false },
		"options": { "type": "array", "default": [] },
		"mask": { "type": "string", "default": "" },
		"maskSourceName": { "type": "string", "default": "" },
		"citiesSourceName": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"className": true,
		"customClassName": true,
		"spacing": { "margin": [ "top", "bottom" ] }
	},
	"editorScript": "file:./index.js"
}
