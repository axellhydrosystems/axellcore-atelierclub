#: includes/blocks/form/form-input/block.json
msgctxt "block title"
msgid "Atelier Form Field"
msgstr "Campo de Formulário do Atelier"

#: includes/blocks/form/form-input/block.json
msgctxt "block description"
msgid "A form field: text, email, tel, number, textarea, select, consent checkbox, or hidden — with optional input masking (CPF/CNPJ, CEP, phone)."
msgstr "Um campo de formulário: texto, e-mail, telefone, número, área de texto, select, checkbox de consentimento ou oculto — com máscara de entrada opcional (CPF/CNPJ, CEP, telefone)."

