#: includes/blocks/chapters/chapter/block.json
msgctxt "block title"
msgid "Atelier Chapter"
msgstr "Atelier — Capítulo"

#: includes/blocks/chapters/chapter/block.json
msgctxt "block description"
msgid "One numbered chapter. The 'Capítulo NN' prefix is generated automatically (CSS counter, not stored text) — reordering chapters in the editor renumbers them without editing any content. Only the label after the number, and the chapter's own content, are stored."
msgstr "Um capítulo numerado. O prefixo \"Capítulo NN\" é gerado automaticamente (contador CSS, não é texto armazenado) — reordenar capítulos no editor os renumera sem editar nenhum conteúdo. Apenas o rótulo após o número, e o conteúdo do próprio capítulo, são armazenados."

#: includes/blocks/chapters/chapter/block.json
#: includes/blocks/chapters/chapters/block.json
