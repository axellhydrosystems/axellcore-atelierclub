msgid "chapter"
msgstr "chapter"

#: includes/blocks/chapters/chapter/block.json
#: includes/blocks/chapters/chapters/block.json
msgctxt "block keyword"
msgid "capítulo"
msgstr "capítulo"

#: includes/blocks/chapters/chapters/block.json
msgctxt "block title"
msgid "Atelier Chapters"
msgstr "Atelier — Capítulos"

#: includes/blocks/chapters/chapters/block.json
msgctxt "block description"
msgid "Groups the page's numbered chapters (axellcore/chapter) and establishes the auto-numbering scope — reordering, adding, or removing a chapter renumbers the rest automatically (CSS counter, not stored text)."
msgstr "Agrupa os capítulos numerados da página (axellcore/chapter) e estabelece o escopo de numeração automática — reordenar, adicionar ou remover um capítulo renumera os demais automaticamente (contador CSS, não é texto armazenado)."

#: includes/blocks/chapters/chapters/block.json
msgctxt "block keyword"
msgid "numbering"
msgstr "numeração"
